---
---
<section class="section featured-office-section">
  <div class="featured-office-bg"></div>
  <div class="container">
    <div class="section-header">
      <h2 class="heading-lg" style="color: #FFFFFF;">Private Office Suite 205 & Executive Spaces</h2>
      <p style="color: rgba(255, 255, 255, 0.85);">Turnkey, fully furnished private suites inside Baur's building. Flexible hourly, daily, or monthly agreements.</p>
    </div>

    <div class="office-tiers-grid">
      
      <!-- Tier 1: 3 Person Office -->
      <div class="office-tier-card">
        <div class="tier-badge">3 Person Office</div>
        <h3>Suite 205 Small Team</h3>
        <p class="tier-rates">$20/hr <span>|</span> $144/day <span>|</span> $807+/mo</p>
        <p style="color: var(--text-dim); font-size: 0.9rem;">Ideal for boutique firms & core startup teams needing privacy, natural daylight, and exposed brickwork.</p>
        <ul class="tier-specs">
          <li><i class="fas fa-check"></i> 3 Ergonomic Workstations</li>
          <li><i class="fas fa-check"></i> 24/7 Secure Keycard Access</li>
          <li><i class="fas fa-check"></i> Mail & Business Address</li>
        </ul>
        <button class="btn btn-teal btn-block" data-open-modal="3-Person Office Suite 205">Tour Suite 205</button>
      </div>

      <!-- Tier 2: 5 Person Office -->
      <div class="office-tier-card featured-tier">
        <div class="tier-badge badge-popular">Most Popular</div>
        <h3>Suite 205 Medium Team</h3>
        <p class="tier-rates">$25/hr <span>|</span> $180/day <span>|</span> $1,200+/mo</p>
        <p style="color: var(--text-dim); font-size: 0.9rem;">Spacious private office with room for 5 team members, whiteboards, glass entryway, and dual fiber lines.</p>
        <ul class="tier-specs">
          <li><i class="fas fa-check"></i> 5 Ergonomic Workstations</li>
          <li><i class="fas fa-check"></i> Custom Door Company Logo</li>
          <li><i class="fas fa-check"></i> Monthly Conference Hours Included</li>
        </ul>
        <button class="btn btn-primary btn-block" data-open-modal="5-Person Office Suite 205">Book Suite Tour</button>
      </div>

      <!-- Tier 3: 7 Person Office -->
      <div class="office-tier-card">
        <div class="tier-badge">7 Person Office</div>
        <h3>Suite 205 Executive Suite</h3>
        <p class="tier-rates">$35/hr <span>|</span> $252/day <span>|</span> $1,325+/mo</p>
        <p style="color: var(--text-dim); font-size: 0.9rem;">Corner executive suite featuring high ceilings, private lounge area, and dedicated fiber ethernet ports.</p>
        <ul class="tier-specs">
          <li><i class="fas fa-check"></i> 7+ Ergonomic Workstations</li>
          <li><i class="fas fa-check"></i> Unlimited Phone Pod Access</li>
          <li><i class="fas fa-check"></i> Priority Event Space Discounts</li>
        </ul>
        <button class="btn btn-teal btn-block" data-open-modal="7-Person Executive Suite 205">Tour Executive Suite</button>
      </div>

    </div>
  </div>
</section>

<style>
.featured-office-section {
  position: relative;
  background-image: url('https://candyfactorycoworking.com/wp-content/uploads/2023/11/CF-205-2.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  color: #FFFFFF;
  padding: 6rem 0;
}

.featured-office-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(1, 33, 57, 0.93) 0%, rgba(1, 33, 57, 0.88) 100%);
  z-index: 0;
}

.featured-office-section .container {
  position: relative;
  z-index: 1;
}

.badge-red-glow {
  background: rgba(214, 64, 80, 0.2);
  color: #FF7B88;
  border: 1px solid rgba(214, 64, 80, 0.4);
  backdrop-filter: blur(8px);
}

.office-tiers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.office-tier-card {
  background: rgba(7, 43, 71, 0.75);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--border-radius-lg);
  padding: 2.2rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  transition: transform var(--transition-normal), border-color var(--transition-normal);
}

.office-tier-card:hover {
  transform: translateY(-6px);
  border-color: var(--secondary-teal);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.office-tier-card.featured-tier {
  background: rgba(14, 54, 86, 0.9);
  border: 2px solid var(--primary-red);
  box-shadow: var(--shadow-red);
}

.tier-badge {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--secondary-teal);
}

.badge-popular {
  background: var(--primary-red);
  color: #FFFFFF;
  padding: 0.25rem 0.75rem;
  border-radius: var(--border-radius-full);
  display: inline-block;
  width: fit-content;
}

.office-tier-card h3 {
  color: #FFFFFF;
  font-size: 1.35rem;
}

.tier-rates {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--secondary-teal);
}

.tier-rates span {
  color: rgba(255, 255, 255, 0.3);
  margin: 0 0.3rem;
}

.tier-specs {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin: 0.5rem 0;
}

.tier-specs li {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.9);
}

.tier-specs li i {
  color: var(--secondary-teal);
}
</style>

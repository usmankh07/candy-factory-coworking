---
<section class="trust-bar-section">
  <div class="container">
    <div class="trust-bar-grid">
      <div class="stat-item">
        <span class="stat-number">1891</span>
        <span class="stat-label">Historic Baur's Heritage</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">1 Gbps</span>
        <span class="stat-label">Ultra-Fast Fiber Network</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">4.9 ★</span>
        <span class="stat-label">Member Experience Score</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">100%</span>
        <span class="stat-label">Flexible Month-to-Month</span>
      </div>
    </div>
  </div>
</section>

<style>
.trust-bar-section {
  background: var(--dark-navy);
  color: #FFFFFF;
  padding: 2.5rem 0;
}

.trust-bar-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 2rem;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.stat-number {
  font-family: var(--font-heading);
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--secondary-teal);
}

.stat-label {
  font-size: 0.9rem;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 600;
}
</style>

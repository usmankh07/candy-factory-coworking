---
---
<section class="section section-bg-white" id="spaces">
  <div class="container">
    <div class="section-header">
      <h2 class="heading-lg">Explore Workspace Memberships</h2>
      <p>Flexible contracts, transparent pricing, and all-inclusive amenities in the heart of Denver CBD.</p>
    </div>

    <!-- Category Tabs -->
    <div class="tabs-navigation">
      <button class="tab-btn active" data-category="all">All Options</button>
      <button class="tab-btn" data-category="desks">Hot & Dedicated Desks</button>
      <button class="tab-btn" data-category="offices">Private Offices</button>
      <button class="tab-btn" data-category="meetings">Meeting & Event Spaces</button>
    </div>

    <!-- Space Cards Grid -->
    <div class="space-cards-grid">
      
      <!-- Card 1: Day Pass -->
      <div class="space-card" data-category="desks">
        <div class="space-card-img">
          <img src="https://candyfactorycoworking.com/wp-content/uploads/2025/11/2nd-floor-main-room-scaled.jpg" alt="Candy Factory Coworking Day Pass Space">
          <span class="space-tag">Drop-In Flexible</span>
        </div>
        <div class="space-card-body">
          <div class="space-card-title-row">
            <h3>Day Pass</h3>
            <div class="space-price">$25 <span>/ day</span></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Instant access to open coworking areas during business hours. Ideal for remote workers passing through Denver.</p>
          <div class="space-features-list">
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> High-Speed Fiber Wifi</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Free Roasted Coffee & Tea</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Lounge & Kitchenette Access</div>
          </div>
          <button class="btn btn-outline btn-block" data-open-modal="Day Pass">Claim Day Pass</button>
        </div>
      </div>

      <!-- Card 2: Dedicated Desk -->
      <div class="space-card" data-category="desks">
        <div class="space-card-img">
          <img src="https://candyfactorycoworking.com/wp-content/uploads/2024/06/201-inside.jpg" alt="Dedicated Desk Space Denver">
          <span class="space-tag">Most Popular</span>
        </div>
        <div class="space-card-body">
          <div class="space-card-title-row">
            <h3>Dedicated Desk</h3>
            <div class="space-price">$500 <span>/ month</span></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Your personal set desk in our vibrant shared workspace. Set up your monitors and lock away gear.</p>
          <div class="space-features-list">
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> 24/7 Secure Keycard Access</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Lockable Storage Cabinet</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Monthly Conference Credits</div>
          </div>
          <button class="btn btn-primary btn-block" data-open-modal="Dedicated Desk">Book Desk Tour</button>
        </div>
      </div>

      <!-- Card 3: Private Office Suite -->
      <div class="space-card" data-category="offices">
        <div class="space-card-img">
          <img src="https://candyfactorycoworking.com/wp-content/uploads/2023/11/CF-205-2.jpg" alt="Private Office Suite Denver Baur's">
          <span class="space-tag">Private Suite</span>
        </div>
        <div class="space-card-body">
          <div class="space-card-title-row">
            <h3>Private Offices</h3>
            <div class="space-price">$807+ <span>/ month</span></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Fully furnished move-in ready suites for 2 to 10+ person teams. Sound-dampened glass and exposed brick architecture.</p>
          <div class="space-features-list">
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Custom Company Door Logo</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Mail & Business Address Service</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Unlimited Phone Booth Use</div>
          </div>
          <button class="btn btn-primary btn-block" data-open-modal="Private Office">Tour Office Suites</button>
        </div>
      </div>

      <!-- Card 4: Small Conference Room -->
      <div class="space-card" data-category="meetings">
        <div class="space-card-img">
          <img src="https://candyfactorycoworking.com/wp-content/uploads/2025/11/small-conference-room-scaled.jpg" alt="Small Conference Room Rental Denver">
          <span class="space-tag">Meeting Room</span>
        </div>
        <div class="space-card-body">
          <div class="space-card-title-row">
            <h3>Small Conference</h3>
            <div class="space-price">$25 <span>/ hour</span></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Private meeting room for up to 6 people. Equipped with HD presentation display, whiteboard, and conference phone.</p>
          <div class="space-features-list">
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Smart Display & Video Conferencing</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> High-Speed Wireless AirPlay/HDMI</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Hourly or Daily Rates</div>
          </div>
          <button class="btn btn-outline btn-block" data-open-modal="Small Conference Room">Reserve Room</button>
        </div>
      </div>

      <!-- Card 5: Large Conference Room -->
      <div class="space-card" data-category="meetings">
        <div class="space-card-img">
          <img src="https://candyfactorycoworking.com/wp-content/uploads/2025/11/large-conference-room-scaled.jpg" alt="Large Conference Room Denver">
          <span class="space-tag">Executive Room</span>
        </div>
        <div class="space-card-body">
          <div class="space-card-title-row">
            <h3>Large Conference</h3>
            <div class="space-price">$59 <span>/ hour</span></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Executive board-style conference room for up to 14 participants. Perfect for client presentations and team offsites.</p>
          <div class="space-features-list">
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Large 4K Monitor & Audio Setup</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Catering Service Available</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Glass Wall & Natural Daylight</div>
          </div>
          <button class="btn btn-outline btn-block" data-open-modal="Large Conference Room">Reserve Room</button>
        </div>
      </div>

      <!-- Card 6: Corporate Event Space -->
      <div class="space-card" data-category="meetings">
        <div class="space-card-img">
          <img src="https://candyfactorycoworking.com/wp-content/uploads/2025/11/2nd-floor-kitchen-scaled.jpg" alt="Corporate Event Rental Space Denver">
          <span class="space-tag">Event Venue</span>
        </div>
        <div class="space-card-body">
          <div class="space-card-title-row">
            <h3>Large Event Space</h3>
            <div class="space-price">$120 <span>/ hour</span></div>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Spacious, character-rich venue in Baur's building. Ideal for mixers, workshops, panel discussions, and launch events.</p>
          <div class="space-features-list">
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Capacity for Up to 80 Guests</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Kitchen Bar & Lounge Seating</div>
            <div class="space-feature-item"><i class="fas fa-check-circle"></i> Sound System & Projector</div>
          </div>
          <button class="btn btn-outline btn-block" data-open-modal="Event Space">Inquire Event Space</button>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.tabs-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

.tab-btn {
  padding: 0.8rem 1.5rem;
  border-radius: var(--border-radius-full);
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--dark-navy);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.tab-btn:hover {
  border-color: var(--primary-red);
  color: var(--primary-red);
}

.tab-btn.active {
  background: var(--primary-red);
  color: #FFFFFF;
  border-color: var(--primary-red);
  box-shadow: var(--shadow-red);
}

.space-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 2rem;
}

.space-card {
  background: #FFFFFF;
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-light);
  transition: all var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.space-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
}

.space-card-img {
  height: 230px;
  position: relative;
  overflow: hidden;
}

.space-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.space-card:hover .space-card-img img {
  transform: scale(1.05);
}

.space-tag {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: rgba(1, 33, 57, 0.85);
  backdrop-filter: blur(8px);
  color: #FFFFFF;
  padding: 0.35rem 0.85rem;
  border-radius: var(--border-radius-full);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
}

.space-card-body {
  padding: 1.8rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  gap: 1rem;
}

.space-card-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.space-price {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--primary-red);
}

.space-price span {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 500;
}

.space-features-list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin: 0.5rem 0;
}

.space-feature-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  color: var(--text-dark);
}

.space-feature-item i {
  color: var(--secondary-teal);
  font-size: 1rem;
}
</style>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const spaceCards = document.querySelectorAll('.space-card');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const category = btn.getAttribute('data-category');
      spaceCards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (category === 'all' || cardCat === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

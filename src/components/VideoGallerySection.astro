---
const rightGalleryImages = [
  {
    src: 'https://candyfactorycoworking.com/wp-content/uploads/2025/11/2nd-floor-main-room-scaled.jpg',
    title: 'Main Coworking Lounge',
    tag: '2nd Floor • Open Workspace'
  },
  {
    src: 'https://candyfactorycoworking.com/wp-content/uploads/2025/11/2nd-floor-kitchen-scaled.jpg',
    title: 'Community Kitchen & Craft Bar',
    tag: '2nd Floor • Amenities'
  },
  {
    src: 'https://candyfactorycoworking.com/wp-content/uploads/2023/11/CF-205-2.jpg',
    title: 'Private Office Suite 205',
    tag: '3-7 Person Dedicated Suite'
  },
  {
    src: 'https://candyfactorycoworking.com/wp-content/uploads/2025/10/patio1.jpg',
    title: 'Outdoor Patio Courtyard',
    tag: 'Relaxation & Events'
  }
];

const leftFeaturedImages = [
  {
    src: 'https://candyfactorycoworking.com/wp-content/uploads/2025/11/2nd-Floor-hall-scaled.jpg',
    title: 'Historic Hallway & Private Suites',
    tag: '2nd Floor • Suite Wing'
  },
  {
    src: 'https://candyfactorycoworking.com/wp-content/uploads/2025/11/large-conference-room-scaled.jpg',
    title: 'Executive Conference Room',
    tag: 'AV & Boardroom Setup'
  }
];
---

<section class="section video-gallery-section" id="gallery">
  <div class="container">
    
    <!-- Clean Concise Header -->
    <div class="section-header">
      <h2 class="heading-lg">Explore Candy Factory Coworking</h2>
      <p>Take a virtual video tour of Baur's building or browse authentic photos of our workspace environments.</p>
    </div>

    <!-- Main Showcase Layout: Video Player + Photo Grid -->
    <div class="media-gallery-grid">
      
      <!-- Left Column: Video Embed Player + 2 Real Photo Cards -->
      <div class="left-media-column">
        <!-- Featured Video Embed -->
        <div class="featured-video-card">
          <div class="video-container">
            <iframe 
              src="https://www.youtube-nocookie.com/embed/QseA6OpATXE?rel=0&modestbranding=1" 
              title="Candy Factory Coworking Denver Video Tour"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              loading="lazy">
            </iframe>
          </div>
          <div class="video-footer">
            <span class="video-badge"><i class="fas fa-play-circle"></i> Official Video Tour</span>
            <button class="btn btn-primary btn-sm" data-open-modal="Gallery Video Tour Book">
              Book a Tour <i class="fas fa-arrow-right"></i>
            </button>
          </div>
        </div>

        <!-- 2 Real Photo Cards Filling the Left Side -->
        <div class="left-photo-row">
          {leftFeaturedImages.map((img) => (
            <div class="gallery-photo-card" data-img-src={img.src} data-img-title={img.title}>
              <img src={img.src} alt={img.title} loading="lazy" />
              <div class="photo-overlay">
                <span class="photo-tag">{img.tag}</span>
                <h5>{img.title}</h5>
                <span class="zoom-btn"><i class="fas fa-expand"></i> View</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: 4 Real Photo Grid -->
      <div class="right-photo-grid">
        {rightGalleryImages.map((img) => (
          <div class="gallery-photo-card" data-img-src={img.src} data-img-title={img.title}>
            <img src={img.src} alt={img.title} loading="lazy" />
            <div class="photo-overlay">
              <span class="photo-tag">{img.tag}</span>
              <h5>{img.title}</h5>
              <span class="zoom-btn"><i class="fas fa-expand"></i> View</span>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Lightbox Modal for Photo Gallery -->
<div class="lightbox-modal" id="lightbox-modal">
  <div class="lightbox-content">
    <button class="lightbox-close" id="lightbox-close">&times;</button>
    <img id="lightbox-img" src="" alt="Full view" />
    <h4 id="lightbox-caption"></h4>
  </div>
</div>

<style>
.video-gallery-section {
  background-color: var(--bg-white);
  padding: 5.5rem 0;
}

.media-gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.8rem;
  align-items: stretch;
}

/* LEFT COLUMN STYLES */
.left-media-column {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.featured-video-card {
  background: var(--dark-navy);
  border-radius: var(--border-radius-lg);
  padding: 0.8rem;
  box-shadow: 0 10px 30px rgba(1, 33, 57, 0.12);
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.video-container {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  border-radius: var(--border-radius-md);
  background: #000000;
}

.video-container iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.video-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.2rem 0.4rem;
}

.video-badge {
  font-size: 0.85rem;
  font-weight: 700;
  color: #FFFFFF;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.video-badge i {
  color: var(--primary-red);
}

.left-photo-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem;
  flex: 1;
}

/* RIGHT COLUMN PHOTO GRID STYLES */
.right-photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 1.2rem;
}

.gallery-photo-card {
  position: relative;
  border-radius: var(--border-radius-md);
  overflow: hidden;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  min-height: 220px;
  background: #012139;
}

.gallery-photo-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.gallery-photo-card:hover img {
  transform: scale(1.06);
}

.photo-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to top, rgba(1, 33, 57, 0.88) 0%, rgba(1, 33, 57, 0.15) 60%);
  color: #FFFFFF;
  padding: 1.1rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0.95;
  transition: opacity 0.3s ease;
}

.gallery-photo-card:hover .photo-overlay {
  opacity: 1;
  background: linear-gradient(to top, rgba(1, 33, 57, 0.95) 0%, rgba(1, 33, 57, 0.25) 100%);
}

.photo-tag {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--secondary-teal);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.photo-overlay h5 {
  color: #FFFFFF;
  font-size: 0.98rem;
  font-weight: 700;
  margin-top: 0.2rem;
}

.zoom-btn {
  position: absolute;
  top: 0.8rem;
  right: 0.8rem;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(4px);
  color: #FFFFFF;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.3rem 0.65rem;
  border-radius: var(--border-radius-full);
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

/* LIGHTBOX MODAL STYLES */
.lightbox-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 15, 30, 0.92);
  backdrop-filter: blur(12px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.lightbox-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.lightbox-content {
  position: relative;
  max-width: 900px;
  width: 90%;
  background: var(--dark-navy);
  border-radius: var(--border-radius-lg);
  padding: 1rem;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
  text-align: center;
}

.lightbox-content img {
  width: 100%;
  max-height: 70vh;
  object-fit: contain;
  border-radius: var(--border-radius-md);
}

.lightbox-content h4 {
  color: #FFFFFF;
  margin-top: 1rem;
  font-size: 1.2rem;
}

.lightbox-close {
  position: absolute;
  top: -15px;
  right: -15px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--primary-red);
  color: #FFFFFF;
  border: none;
  font-size: 1.5rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: var(--shadow-red);
}

@media (max-width: 1024px) {
  .media-gallery-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .right-photo-grid, .left-photo-row {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  const cards = document.querySelectorAll('.gallery-photo-card');
  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const modalCaption = document.getElementById('lightbox-caption');
  const closeBtn = document.getElementById('lightbox-close');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const src = card.getAttribute('data-img-src');
      const title = card.getAttribute('data-img-title');
      if (src && modalImg && modalCaption && modal) {
        modalImg.src = src;
        modalCaption.textContent = title || '';
        modal.classList.add('active');
      }
    });
  });

  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => {
      modal.classList.remove('active');
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });
  }
</script>

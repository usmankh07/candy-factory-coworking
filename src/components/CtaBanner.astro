---
---
<section class="cta-banner-section">
  <div class="container">
    <div class="cta-banner-content">
      <h2 class="heading-lg">Ready to Elevate Your Daily Workday?</h2>
      <p>Schedule a personal walkthrough of Baur's building or claim your complimentary 1-day pass now.</p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
        <button class="btn btn-secondary btn-lg" data-open-modal="Homepage Bottom Banner">
          <i class="fas fa-calendar-alt"></i> Schedule a Private Tour
        </button>
        <a href="#" class="btn btn-teal btn-lg" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
          <i class="fas fa-ticket-alt"></i> Claim Free Day Pass
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.cta-banner-section {
  position: relative;
  background: linear-gradient(135deg, var(--primary-red) 0%, #B82E3E 100%);
  color: #FFFFFF;
  padding: 5rem 0;
  overflow: hidden;
  text-align: center;
}

.cta-banner-content {
  position: relative;
  z-index: 1;
  max-width: 750px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.cta-banner-content h2 {
  color: #FFFFFF;
}

.cta-banner-content p {
  font-size: 1.15rem;
  color: rgba(255, 255, 255, 0.9);
}
</style>

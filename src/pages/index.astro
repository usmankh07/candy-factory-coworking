---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import PromotionsBanner from '../components/PromotionsBanner.astro';
import WorkspaceMatcher from '../components/WorkspaceMatcher.astro';
import FeaturedOfficeSpotlight from '../components/FeaturedOfficeSpotlight.astro';
import SpacesShowcase from '../components/SpacesShowcase.astro';
import VideoGallerySection from '../components/VideoGallerySection.astro';
import HistoryStory from '../components/HistoryStory.astro';
import Amenities from '../components/Amenities.astro';
import Transportation from '../components/Transportation.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import TourModal from '../components/TourModal.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <TrustBar />
    <PromotionsBanner />
    <WorkspaceMatcher />
    <FeaturedOfficeSpotlight />
    <SpacesShowcase />
    <VideoGallerySection />
    <HistoryStory />
    <Amenities />
    <Transportation />
    <Testimonials />
    <Faq />
    <CtaBanner />
  </main>
  <Footer />
  <TourModal />
</Layout>

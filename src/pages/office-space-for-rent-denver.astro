---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TourModal from '../components/TourModal.astro';

const officeSuites = [
  {
    suite: 'Suite 201',
    capacity: '1 - 2 People',
    size: '180 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2024/06/201-inside.jpg',
    type: 'Private Window Office',
    price: 'Starting at $850/mo',
    features: ['High Timber Ceilings', 'Natural Window Light', 'Ergonomic Desk & Chairs', '1,000 Mbps Fiber WiFi'],
    category: 'small'
  },
  {
    suite: 'Suite 203',
    capacity: '3 - 5 People',
    size: '260 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2024/06/203-inside.jpg',
    type: 'Executive Suite',
    price: 'Starting at $1,450/mo',
    features: ['Exposed Brick Accent', 'Private Keycard Lock', 'Fully Furnished 4-Desk Setup', 'Direct Kitchen Access'],
    category: 'medium'
  },
  {
    suite: 'Suite 204',
    capacity: '2 - 4 People',
    size: '220 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2024/06/204.jpg',
    type: 'Quiet Team Suite',
    price: 'Starting at $1,200/mo',
    features: ['Acoustic Insulation', 'Custom Desk Layout', 'Whiteboard Wall Included', 'Included Meeting Credits'],
    category: 'small'
  },
  {
    suite: 'Suite 205 (Featured)',
    capacity: '4 - 8 People',
    size: '380 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2023/11/CF-205-2.jpg',
    type: 'Corner Executive Suite',
    price: 'Inquire for Custom Rate',
    features: ['Double Corner Windows', 'Private Lounge Area', 'Turnkey 6-Desk Setup', 'Priority Conference Booking'],
    category: 'large'
  },
  {
    suite: 'Suite 206',
    capacity: '2 - 3 People',
    size: '195 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2024/06/206.jpg',
    type: 'Internal Private Suite',
    price: 'Starting at $950/mo',
    features: ['Glass Entry Door', 'Fully Carpeted', 'High Speed Ethernet + WiFi', 'Daily Janitorial Service'],
    category: 'small'
  },
  {
    suite: 'Suite 207',
    capacity: '5 - 10 People',
    size: '420 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2024/06/207-int.jpg',
    type: 'Large Department Suite',
    price: 'Inquire for Custom Rate',
    features: ['Open Layout + Executive Corner', 'Private Storage Cabinets', 'Flexible Lease Terms', '24/7 Secure Access'],
    category: 'large'
  },
  {
    suite: 'Suite 209',
    capacity: '3 - 5 People',
    size: '280 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2023/07/CF-209-2.jpg',
    type: 'Sunlit Private Suite',
    price: 'Starting at $1,500/mo',
    features: ['Original 1891 Hardwood', 'High Ceiling Beam Structure', 'Keycard Access Control', 'Complimentary Craft Coffee'],
    category: 'medium'
  },
  {
    suite: 'Suite 210',
    capacity: '4 - 6 People',
    size: '320 sq ft',
    image: 'https://candyfactorycoworking.com/wp-content/uploads/2024/06/210-ext.jpg',
    type: 'Corner Team Suite',
    price: 'Starting at $1,750/mo',
    features: ['Courtyard View', 'Ergonomic Task Chairs', 'Dedicated Mailbox Service', 'Guest Reception Support'],
    category: 'medium'
  }
];

const officePerks = [
  {
    icon: 'fas fa-chair',
    title: '100% Turnkey & Furnished',
    desc: 'Move in today with premium ergonomic desks, executive chairs, and custom office layouts tailored to your team.'
  },
  {
    icon: 'fas fa-file-contract',
    title: 'Flexible Agreement Terms',
    desc: 'Choose from 6-month or 12-month lease options with our Current Special: Free Month on any 6-Month Lease!'
  },
  {
    icon: 'fas fa-receipt',
    title: 'All-Inclusive Transparent Rate',
    desc: 'No hidden utility bills, WiFi fees, or cleaning add-ons. One flat monthly invoice covers every overhead cost.'
  },
  {
    icon: 'fas fa-landmark',
    title: 'Historic Baur’s Building',
    desc: 'Inspire your team inside Denver’s iconic 1891 landmark featuring high timber ceilings, brick walls, and character.'
  }
];

const officeFaqs = [
  {
    q: 'What is included with a private office space rental?',
    a: 'Every private office suite includes full furnishing (desks, chairs), 1,000 Mbps Fiber WiFi & hardwired ethernet, 24/7 keycard building access, business mail handling, access to soundproof phone booths, unlimited craft coffee & tea, private patio access, and monthly conference room credits.'
  },
  {
    q: 'Can we bring our own furniture or brand our office suite?',
    a: 'Yes! While all suites come turnkey furnished, you are welcome to bring custom furniture, artwork, branding signage, whiteboards, or decor to personalize your suite to your brand identity.'
  },
  {
    q: 'How does the "Free Month on 6-Month Lease" special work?',
    a: 'When you sign a 6-month agreement for any available private office suite, your first full month of rent is 100% complimentary.'
  },
  {
    q: 'What are the building access hours for office space members?',
    a: 'Office suite members receive 24/7/365 secure mobile keycard access to the building, 2nd-floor office wing, kitchen, amenities, and courtyard patio.'
  },
  {
    q: 'Where can our team and clients park?',
    a: 'We are located on 1514 Curtis Street in the Denver Theatre District & CBD. There are multiple structured parking garages right next door and across the street, as well as metered street parking and RTD Light Rail stations within a 4-minute walk.'
  }
];
---

<Layout 
  title="Office Space for Rent in Denver | Private Suites | Candy Factory Coworking"
  description="Discover turnkey private office space for rent in Denver at the historic 1891 Baur's Building. Fully furnished suites, all-inclusive utilities, 24/7 access & flexible leases."
>
  <Header />

  <!-- HERO SECTION: Dedicated Office Space Page -->
  <section class="office-hero">
    <div class="office-hero-bg"></div>
    <div class="container">
      <div class="office-hero-content">
        
        <div class="hero-left">
          <span class="category-badge"><i class="fas fa-door-closed"></i> Private Office Suites • Downtown Denver</span>
          <h1 class="heading-xl">Private Office Space for Rent in Denver</h1>
          <p class="hero-subtext">
            Turnkey, fully furnished private office suites inside the historic 1891 Baur's Building. 
            Enjoy high timber ceilings, all-inclusive utilities, 24/7 access, and flexible 6 to 12-month agreements.
          </p>

          <!-- Promo Badge Callout -->
          <div class="hero-promo-badge">
            <i class="fas fa-gift"></i>
            <span><strong>Current Special:</strong> Free Month on Private Office Space with any 6-Month Lease!</span>
          </div>

          <div class="hero-cta-group">
            <button class="btn btn-primary" data-open-modal="Office Page Hero Schedule Tour">
              Schedule A Private Tour <i class="fas fa-arrow-right"></i>
            </button>
            <a href="#suite-inventory" class="btn btn-outline-light">
              Explore Available Suites <i class="fas fa-chevron-down"></i>
            </a>
          </div>

          <div class="hero-quick-features">
            <span><i class="fas fa-check-circle"></i> 1 to 10+ Person Teams</span>
            <span><i class="fas fa-check-circle"></i> 100% All-Inclusive</span>
            <span><i class="fas fa-check-circle"></i> 24/7 Secure Access</span>
          </div>
        </div>

        <!-- Quick Tour Form Widget -->
        <div class="hero-form-card">
          <h3>Schedule Office Suite Tour</h3>
          <p>Walk through available suites with our community manager.</p>

          <form class="hero-lead-form" onsubmit="event.preventDefault(); alert('Thank you! Our community manager will contact you immediately to confirm your office tour.');">
            <div class="form-group">
              <input type="text" placeholder="Full Name *" required class="form-input" />
            </div>
            <div class="form-group">
              <input type="email" placeholder="Work Email *" required class="form-input" />
            </div>
            <div class="form-group">
              <input type="tel" placeholder="Phone Number *" required class="form-input" />
            </div>
            <div class="form-group">
              <select required class="form-input">
                <option value="" disabled selected>Team Size Needed *</option>
                <option value="1-2">1 - 2 People</option>
                <option value="3-5">3 - 5 People</option>
                <option value="6-10">6 - 10 People</option>
                <option value="10+">10+ People (Custom Suite)</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary btn-block">
              Request Private Tour <i class="fas fa-paper-plane"></i>
            </button>
            <div class="form-guarantee">
              <i class="fas fa-shield-alt"></i> Instant confirmation • Zero pressure
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- VALUE PROPOSITION BAR -->
  <section class="section section-bg-light">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="heading-lg">Why Rent Office Space at Baur's Building?</h2>
        <p>Elevate your business presence with an authentic, inspiring workspace in Denver's CBD Theatre District.</p>
      </div>

      <div class="props-grid">
        {officePerks.map((perk) => (
          <div class="prop-card">
            <div class="prop-icon">
              <i class={perk.icon}></i>
            </div>
            <h3>{perk.title}</h3>
            <p>{perk.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SUITE INVENTORY & INTERACTIVE FILTER -->
  <section class="section section-bg-white" id="suite-inventory">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="heading-lg">Explore Available Private Office Suites</h2>
        <p>Browse move-in ready office suites tailored for solo founders, growing startups, and established team branches.</p>
      </div>

      <!-- Suite Filter Tabs -->
      <div class="suite-filter-bar">
        <button class="filter-tab active" data-filter="all">All Suites</button>
        <button class="filter-tab" data-filter="small">1 - 2 People</button>
        <button class="filter-tab" data-filter="medium">3 - 5 People</button>
        <button class="filter-tab" data-filter="large">6+ People</button>
      </div>

      <!-- Office Suites Grid -->
      <div class="suites-grid">
        {officeSuites.map((suite) => (
          <div class={`suite-card category-${suite.category}`}>
            <div class="suite-image-wrap">
              <img src={suite.image} alt={suite.suite} loading="lazy" />
              <span class="capacity-badge"><i class="fas fa-users"></i> {suite.capacity}</span>
              <span class="type-tag">{suite.type}</span>
            </div>
            
            <div class="suite-body">
              <div class="suite-header">
                <h3>{suite.suite}</h3>
                <span class="suite-price">{suite.price}</span>
              </div>
              
              <div class="suite-meta">
                <span><i class="fas fa-ruler-combined"></i> {suite.size}</span>
                <span><i class="fas fa-shield-halved"></i> 24/7 Keycard</span>
              </div>

              <ul class="suite-features-list">
                {suite.features.map(f => (
                  <li><i class="fas fa-check"></i> {f}</li>
                ))}
              </ul>

              <button class="btn btn-primary btn-block" data-open-modal={`Book Tour for ${suite.suite}`}>
                Schedule Tour For {suite.suite} <i class="fas fa-calendar-check"></i>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED SUITE 205 SPOTLIGHT -->
  <section class="section suite-spotlight-section">
    <div class="spotlight-bg"></div>
    <div class="container">
      <div class="spotlight-grid">
        <div class="spotlight-content">
          <span class="spotlight-badge"><i class="fas fa-star"></i> Featured Executive Suite</span>
          <h2 class="heading-lg text-white">Suite 205 Executive Corner Suite</h2>
          <p class="text-dim">
            Our premier 380 sq ft double-corner private suite features dual exterior windows overlooking Curtis Street, 
            original 1891 brick accents, a private meeting lounge, and workstation capacity for 4 to 8 team members.
          </p>

          <div class="spotlight-perks">
            <div class="s-perk"><i class="fas fa-sun"></i> Dual Corner Windows</div>
            <div class="s-perk"><i class="fas fa-couch"></i> Private Lounge Seating</div>
            <div class="s-perk"><i class="fas fa-wifi"></i> Dedicated Gigabit Port</div>
            <div class="s-perk"><i class="fas fa-gift"></i> 1st Month Free Special</div>
          </div>

          <div class="spotlight-cta">
            <button class="btn btn-primary btn-lg" data-open-modal="Suite 205 Private Tour">
              Book Suite 205 Tour <i class="fas fa-arrow-right"></i>
            </button>
          </div>
        </div>

        <div class="spotlight-image-card">
          <img src="https://candyfactorycoworking.com/wp-content/uploads/2023/11/CF-205-2.jpg" alt="Candy Factory Coworking Suite 205" />
          <div class="image-caption">
            <span>Executive Suite 205 • Historic Baur's Building</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OFFICE INCLUDED AMENITIES SECTION -->
  <section class="section section-bg-light">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="heading-lg">All-Inclusive Office Amenities</h2>
        <p>No extra fees for internet, coffee, phone booths, or cleaning. Everything is included in your office agreement.</p>
      </div>

      <div class="office-amenities-grid">
        <div class="o-amenity"><i class="fas fa-wifi"></i> <h4>Gigabit Fiber WiFi & LAN</h4><p>1,000 Mbps symmetrical high-speed internet.</p></div>
        <div class="o-amenity"><i class="fas fa-phone-alt"></i> <h4>Soundproof Phone Pods</h4><p>Acoustic private booths for confidential Zoom calls.</p></div>
        <div class="o-amenity"><i class="fas fa-mug-hot"></i> <h4>Craft Coffee & Snacks</h4><p>Unlimited locally roasted coffee, teas & candy bar.</p></div>
        <div class="o-amenity"><i class="fas fa-tree"></i> <h4>Outdoor Courtyard Patio</h4><p>Private outdoor terrace for meetings & fresh air.</p></div>
        <div class="o-amenity"><i class="fas fa-mail-bulk"></i> <h4>Business Mail & Address</h4><p>Official 1514 Curtis St business suite address.</p></div>
        <div class="o-amenity"><i class="fas fa-dog"></i> <h4>Dog Friendly Space</h4><p>Well-behaved pets welcome at your private desk.</p></div>
        <div class="o-amenity"><i class="fas fa-calendar-alt"></i> <h4>Meeting Room Credits</h4><p>Monthly credits for conference room bookings.</p></div>
        <div class="o-amenity"><i class="fas fa-key"></i> <h4>24/7 Mobile Keycard Access</h4><p>Secure round-the-clock entrance every day.</p></div>
      </div>
    </div>
  </section>

  <!-- OFFICE SPACE FAQ -->
  <section class="section section-bg-white">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="heading-lg">Office Space FAQs</h2>
        <p>Common questions about renting a private office suite at Candy Factory Coworking.</p>
      </div>

      <div class="faq-container">
        {officeFaqs.map((faq, idx) => (
          <div class="faq-item">
            <button class="faq-question" id={`office-faq-btn-${idx}`}>
              <span>{faq.q}</span>
              <i class="fas fa-plus faq-icon"></i>
            </button>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CONVERSION CTA BANNER -->
  <section class="section office-cta-banner">
    <div class="container">
      <div class="cta-banner-card">
        <h2>Ready to Move Into Your New Denver Office Space?</h2>
        <p>Claim our <strong>Free Month Special</strong> on any 6-month private office agreement today.</p>
        <div class="cta-btn-wrapper">
          <button class="btn btn-header-red btn-lg" data-open-modal="Office Page Bottom CTA Tour">
            Schedule Your Private Tour <i class="fas fa-arrow-right"></i>
          </button>
          <a href="tel:3025219500" class="btn btn-outline-light btn-lg">
            <i class="fas fa-phone-alt"></i> Call (302) 521-9500
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <TourModal />
</Layout>

<style>
/* HERO SECTION STYLES */
.office-hero {
  position: relative;
  padding: 12rem 0 6rem 0;
  background: var(--dark-navy);
  color: #FFFFFF;
  overflow: hidden;
}

.office-hero h1 {
  color: #FFFFFF;
  font-family: var(--font-heading);
}

.office-hero h2,
.office-hero h3 {
  font-family: var(--font-heading);
}

.office-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: linear-gradient(to right, rgba(1, 33, 57, 0.94) 30%, rgba(1, 33, 57, 0.75) 100%), url('https://candyfactorycoworking.com/wp-content/uploads/2024/06/1512-1514-Curtis-St-Denver-CO-Historic-Charm-Mixed-with-a-Modern-Touch-2-LargeHighDefinition.jpg');
  background-size: cover;
  background-position: center;
  z-index: 1;
}

.office-hero .container {
  position: relative;
  z-index: 2;
}

.office-hero-content {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 3rem;
  align-items: center;
}

.category-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--secondary-teal);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 1rem;
}

.hero-subtext {
  font-size: 1.12rem;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.6;
  margin: 1.2rem 0;
}

.hero-promo-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: rgba(214, 64, 80, 0.18);
  border: 1px solid rgba(214, 64, 80, 0.45);
  padding: 0.75rem 1.2rem;
  border-radius: var(--border-radius-md);
  margin-bottom: 1.8rem;
  font-size: 0.95rem;
  color: #FFFFFF;
}

.hero-promo-badge i {
  color: var(--primary-red);
  font-size: 1.2rem;
}

.hero-cta-group {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  margin-bottom: 2rem;
}

.hero-quick-features {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
}

.hero-quick-features i {
  color: var(--secondary-teal);
}

/* HERO FORM CARD */
.hero-form-card {
  background: #FFFFFF;
  border-radius: var(--border-radius-lg);
  padding: 2.2rem;
  color: var(--dark-navy);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
}

.hero-form-card h3 {
  font-size: 1.35rem;
  font-weight: 800;
  margin-bottom: 0.3rem;
  color: var(--dark-navy);
}

.hero-form-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 1.4rem;
}

.hero-lead-form .form-group {
  margin-bottom: 1rem;
}

.hero-lead-form .form-input {
  width: 100%;
  padding: 0.85rem 1rem;
  border: 1.5px solid var(--border-light);
  border-radius: var(--border-radius-sm);
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--text-dark);
  background: #F8FAFC;
  outline: none;
  transition: border-color 0.25s ease;
}

.hero-lead-form .form-input:focus {
  border-color: var(--primary-red);
}

.hero-form-card .form-guarantee {
  text-align: center;
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-top: 0.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
}

/* BUTTON VARIANTS NEEDED ON THIS PAGE */
.btn-outline-light {
  background: transparent;
  color: #FFFFFF;
  border: 2px solid rgba(255, 255, 255, 0.4);
}

.btn-outline-light:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: #FFFFFF;
  transform: translateY(-2px);
}

.btn-header-red {
  background: linear-gradient(135deg, var(--primary-red) 0%, #C02B0A 100%);
  color: #FFFFFF;
  box-shadow: var(--shadow-red);
}

.btn-header-red:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(214, 64, 80, 0.45);
  background: linear-gradient(135deg, #E24A5C 0%, #D64050 100%);
}

/* VALUE PROPOSITION CARDS */
.props-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  margin-top: 2.5rem;
}

.prop-card {
  background: #FFFFFF;
  padding: 1.8rem 1.5rem;
  border-radius: var(--border-radius-md);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm);
  transition: transform 0.25s ease;
}

.prop-card:hover {
  transform: translateY(-4px);
  border-color: var(--primary-red);
}

.prop-icon {
  width: 50px;
  height: 50px;
  border-radius: 12px;
  background: var(--primary-red-light);
  color: var(--primary-red);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  margin-bottom: 1.2rem;
}

.prop-card h3 {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: var(--dark-navy);
}

.prop-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.5;
}

/* SUITE INVENTORY & FILTER */
.suite-filter-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  margin-bottom: 2.5rem;
}

.filter-tab {
  padding: 0.6rem 1.4rem;
  border-radius: var(--border-radius-full);
  border: 1px solid var(--border-light);
  background: #FFFFFF;
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--dark-navy);
  cursor: pointer;
  transition: all 0.25s ease;
}

.filter-tab.active, .filter-tab:hover {
  background: var(--primary-red);
  color: #FFFFFF;
  border-color: var(--primary-red);
}

.suites-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.8rem;
}

.suite-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s ease, box-shadow 0.3s ease;

  display: flex;
  flex-direction: column;
}

.suite-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
}

.suite-image-wrap {
  position: relative;
  height: 210px;
  overflow: hidden;
}

.suite-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.suite-card:hover .suite-image-wrap img {
  transform: scale(1.06);
}

.capacity-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: rgba(1, 33, 57, 0.85);
  backdrop-filter: blur(4px);
  color: #FFFFFF;
  font-size: 0.8rem;
  font-weight: 700;
